    "Delete account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销账号"
          }
        }
      }
    },
    "Delete your PinHaoYun account?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销你的 PinHaoYun 账号？"
          }
        }
      }
    },
    "This deletes the account shared by Web and iOS. Access stops immediately and cloud photos, videos and account data will be deleted within 30 days.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销作用于 Web 与 iOS 共用账号。访问会立即停止，云端照片、视频和账号资料将在 30 天内删除。"
          }
        }
      }
    },
    "Photos on your device are kept. Download any cloud originals you need before continuing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机相册会保留。继续之前，请先下载你需要的云端原件。"
          }
        }
      }
    },
    "Confirm your identity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份"
          }
        }
      }
    },
    "Delete account and cloud data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销账号并删除云端资料"
          }
        }
      }
    },
    "Permanently delete your account?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久注销账号？"
          }
        }
      }
    },
    "Confirm account deletion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认注销账号"
          }
        }
      }
    },
    "There is no recovery promise after deletion begins.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
